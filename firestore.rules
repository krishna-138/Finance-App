rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure starter template for future Firebase integration.
    // Each signed-in user's data must live under users/{uid}/... .
    // This app's current prototype still uses localStorage and does NOT use these rules yet.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Deny all other paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
